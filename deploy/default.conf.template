server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Docker embedded DNS. Resolve again after a backend container is recreated.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $auth_backend "${AUTH_UPSTREAM}";
    set $dem_backend "${DEM_UPSTREAM}";

    location ^~ /api/auth/ {
        rewrite ^/api/auth/(.*)$ /$1 break;
        proxy_pass $auth_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location ^~ /api/vulcano/ {
        rewrite ^/api/vulcano/(.*)$ /$1 break;
        proxy_pass $dem_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /api/ { return 404; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location / { try_files $uri $uri/ /index.html; }
}
